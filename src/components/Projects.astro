---
import Section from "./Section.astro";
import { siteConfig } from "../config";
---

{
  siteConfig.projects.length > 0 && (
    <Section id="projects" title="Projects">
      <ul class="space-y-5">
        {siteConfig.projects.map((p) => (
          <li>
            <article class="rounded-lg border border-neutral-200 p-5 dark:border-neutral-800">
              <h3 class="text-lg font-semibold">
                {p.link ? (
                  <a
                    href={p.link}
                    rel="noopener noreferrer"
                    class="text-blue-700 underline-offset-4 hover:underline dark:text-blue-400"
                  >
                    {p.name}
                    <span class="sr-only"> (opens on GitHub)</span>
                  </a>
                ) : (
                  p.name
                )}
              </h3>
              <p class="mt-2 text-neutral-700 dark:text-neutral-300">{p.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {p.skills.map((s) => (
                  <li class="rounded-md bg-neutral-100 px-2.5 py-0.5 text-sm font-medium text-neutral-800 dark:bg-neutral-800 dark:text-neutral-100">
                    {s}
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))}
      </ul>
    </Section>
  )
}
