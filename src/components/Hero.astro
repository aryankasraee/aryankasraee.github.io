---
import { siteConfig } from "../config";

const { email, linkedin, github, twitter } = siteConfig.social;
const linkClass =
  "inline-flex items-center rounded-md border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-900 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-100 dark:hover:bg-neutral-800";
---

<section id="top" class="pb-10 pt-14 sm:pt-20">
  <p class="font-mono text-sm text-blue-700 dark:text-blue-400">{siteConfig.location}</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{siteConfig.name}</h1>
  <p class="mt-2 text-xl font-medium text-neutral-700 dark:text-neutral-300 sm:text-2xl">
    {siteConfig.title}
  </p>
  <p class="mt-6 max-w-2xl text-lg text-neutral-700 dark:text-neutral-300">
    {siteConfig.tagline}
  </p>
  <ul class="mt-8 flex flex-wrap gap-3 print:hidden" aria-label="Contact links">
    <li><a class={linkClass} href={`mailto:${email}`}>Email</a></li>
    <li><a class={linkClass} href={linkedin} rel="noopener noreferrer">LinkedIn</a></li>
    <li><a class={linkClass} href={github} rel="noopener noreferrer">GitHub</a></li>
    <li><a class={linkClass} href={twitter} rel="noopener noreferrer">X</a></li>
    <li>
      <button type="button" class={linkClass} onclick="window.print()">
        Save as PDF
      </button>
    </li>
  </ul>
  <p class="mt-6 hidden text-sm print:block">
    {email} · {linkedin.replace("https://www.", "")} · {github.replace("https://", "")}
  </p>
</section>
