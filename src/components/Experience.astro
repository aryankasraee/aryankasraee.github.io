---
import Section from "./Section.astro";
import { siteConfig } from "../config";
---

<Section id="experience" title="Experience">
  <ol class="space-y-10">
    {
      siteConfig.experience.map((job) => (
        <li>
          <article>
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h3 class="text-lg font-semibold">{job.title}</h3>
              <p class="font-mono text-sm text-neutral-600 dark:text-neutral-400">
                {job.dateRange}
              </p>
            </div>
            <p class="font-medium text-blue-700 dark:text-blue-400">{job.company}</p>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-neutral-700 marker:text-neutral-400 dark:text-neutral-300">
              {job.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</Section>
