---
const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-neutral-200 py-10 dark:border-neutral-800 sm:py-12">
  <h2 id={`${id}-title`} class="text-2xl font-bold tracking-tight sm:text-3xl">
    {title}
  </h2>
  <div class="mt-6">
    <slot />
  </div>
</section>
