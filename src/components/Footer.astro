---
import { siteConfig } from "../config";
---

<footer class="border-t border-neutral-200 py-8 text-sm text-neutral-600 dark:border-neutral-800 dark:text-neutral-400 print:hidden">
  <p>
    {siteConfig.name} · {siteConfig.title} ·
    <a class="underline underline-offset-4 hover:text-neutral-950 dark:hover:text-white" href={`mailto:${siteConfig.social.email}`}>
      {siteConfig.social.email}
    </a>
  </p>
</footer>
